'use client'

import { memo } from 'react'
import { format } from 'date-fns'
import { cn } from '@/lib/utils'
import { Badge } from '@/components/ui/badge'
import { moveTask } from '@/actions/tasks'
import { Check, Circle, Clock, Calendar, Link2 } from 'lucide-react'
import { EnergyIndicator } from '@/components/ui/energy-selector'
import { FocusTimer } from '@/components/tasks/focus-timer'
import type { Task, Project } from '@/types/database'

interface BlockingTask {
  id: string
  title: string
  status: string
}

interface TaskCardProps {
  task: Task & { blocking_task?: BlockingTask | null }
  project?: Project
  showProject?: boolean
  onComplete?: () => void
  onEdit?: (task: Task) => void
}

const priorityColors: Record<string, string> = {
  '1': 'bg-red-500',
  '2': 'bg-orange-500',
  '3': 'bg-blue-500',
  '4': 'bg-gray-400',
}

// Memoized TaskCard for performance
export const TaskCard = memo(function TaskCard({ task, project, showProject = false, onComplete, onEdit }: TaskCardProps) {
  // Use blocking_task from props (should be loaded by parent query)
  const blockingTask = task.blocking_task || null
  const isBlocked = Boolean(blockingTask && blockingTask.status !== 'done')

  const handleToggleComplete = async () => {
    if (isBlocked) return // Cannot complete if blocked

    if (task.status === 'done') {
      await moveTask(task.id, 'inbox')
    } else {
      await moveTask(task.id, 'done')
      if (onComplete) onComplete()
    }
  }

  return (
    <div
      className={cn(
        'group bg-card border rounded-lg p-3 transition-shadow hover:shadow-md',
        task.status === 'done' && 'opacity-60'
      )}
    >
      <div className="flex items-start gap-3">
        {/* Complete checkbox */}
        <button
          type="button"
          onClick={handleToggleComplete}
          disabled={isBlocked}
          className={cn(
            'flex-shrink-0 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors mt-0.5',
            task.status === 'done'
              ? 'bg-primary border-primary text-primary-foreground'
              : isBlocked
                ? 'border-orange-400 bg-orange-100 cursor-not-allowed'
                : 'border-muted-foreground/50 hover:border-primary'
          )}
          title={isBlocked ? `Blocked by: ${blockingTask?.title}` : undefined}
        >
          {task.status === 'done' && <Check className="w-3 h-3" />}
          {isBlocked && task.status !== 'done' && <Link2 className="w-3 h-3 text-orange-500" />}
        </button>

        {/* Main content - clickable to edit */}
        <div
          className="flex-1 min-w-0 cursor-pointer"
          onClick={() => onEdit?.(task)}
        >
          <div className="flex items-start justify-between gap-2">
            <div className="flex items-center gap-2 min-w-0">
              <h3
                className={cn(
                  'font-medium text-sm truncate',
                  task.status === 'done' && 'line-through text-muted-foreground'
                )}
              >
                {task.title}
              </h3>
              <EnergyIndicator energy={task.energy_level} />
            </div>

            <div className="flex items-center gap-2 flex-shrink-0" onClick={(e) => e.stopPropagation()}>
              {/* Focus timer */}
              {task.status !== 'done' && (
                <FocusTimer taskId={task.id} taskTitle={task.title} />
              )}
              {/* Priority indicator */}
              <div
                className={cn(
                  'w-2 h-2 rounded-full',
                  priorityColors[task.priority]
                )}
                title={`Priority ${task.priority}`}
              />
            </div>
          </div>

          {/* Meta info */}
          <div className="flex flex-wrap items-center gap-2 mt-1 text-xs text-muted-foreground">
            {showProject && project && (
              <Badge variant="secondary" className="text-xs">
                <span
                  className="w-2 h-2 rounded-full mr-1"
                  style={{ backgroundColor: project.color }}
                />
                {project.name}
              </Badge>
            )}

            {/* Blocker badge */}
            {blockingTask && (
              <span
                className={cn(
                  'inline-flex items-center gap-1 px-2 py-0.5 rounded-full',
                  blockingTask.status === 'done'
                    ? 'bg-green-100 text-green-700'
                    : 'bg-orange-100 text-orange-700'
                )}
              >
                <Link2 className="w-3 h-3" />
                <span className="truncate max-w-[120px]">
                  {blockingTask.status === 'done' ? 'Unblocked' : 'Blocked by'}: {blockingTask.title}
                </span>
              </span>
            )}

            {task.start_date && (
              <span className="flex items-center gap-1 text-blue-600">
                <Circle className="w-3 h-3" />
                Start: {format(new Date(task.start_date + 'T12:00:00'), 'MMM d')}
              </span>
            )}

            {task.due_date && (
              <span className="flex items-center gap-1 text-orange-600">
                <Calendar className="w-3 h-3" />
                Due: {format(new Date(task.due_date + 'T12:00:00'), 'MMM d')}
              </span>
            )}

            {task.estimate_hours && (
              <span className="flex items-center gap-1">
                <Clock className="w-3 h-3" />
                {task.estimate_hours}h
              </span>
            )}

            {task.actual_hours && task.actual_hours > 0 && (
              <span className="flex items-center gap-1 text-purple-600">
                <Clock className="w-3 h-3" />
                Actual: {task.actual_hours}h
              </span>
            )}
          </div>

        </div>
      </div>
    </div>
  )
})
